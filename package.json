{
  "name": "project-template",
  "version": "1.0.0",
  "description": "Capstone Project Template ",
  "repository": {
    "type": "git",
    "url": "https://autocode.git.epam.com/campus_javascript/capstone-project/project-template.git"
  },
  "license": "ISC",
  "author": "",
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "compile:sass": "sass src/scss:dist/css --no-source-map",
    "compile:ts": "tsc",
    "compile": "npm-run-all compile:sass compile:ts",
    "watch:sass": "sass src/scss:dist/css --watch",
    "watch:ts": "tsc --watch",
    "serve": "live-server --port=3000 --watch=dist,src/**/*.html",
    "dev": "npm run compile && npm-run-all --parallel watch:sass watch:ts serve",
    "lint:js": "eslint ./src --ext .js,.ts",
    "lint:style": "stylelint \"src/**/*.scss\"",
    "lint": "npm-run-all lint:js lint:style",
    "lint:fix": "npm-run-all \"lint:js -- --fix\" \"lint:style -- --fix\""
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "eslint": "^8.57.1",
    "live-server": "^1.2.0",
    "npm-run-all": "^1.1.3",
    "sass": "^1.107.1",
    "stylelint": "^17.16.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "^5.3.3"
  }
}
